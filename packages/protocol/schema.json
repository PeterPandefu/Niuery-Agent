{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "执行器请求",
  "type": "object",
  "required": ["version", "requestId", "method", "payload"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "method": { "enum": ["hello", "providers.list", "history.list", "events.list", "run.start", "run.cancel", "run.continue", "approval.respond", "workspace.diff", "artifact.undo", "worker.shutdown"] },
    "payload": { "type": "object" }
  }
}
